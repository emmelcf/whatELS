{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "PlatformIO: Build (esp32s3)",
      "command": "pio run -e esp32s3",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "type": "shell",
      "label": "PlatformIO: Build (esp32s3-usb-keyboard)",
      "command": "pio run -e esp32s3-usb-keyboard",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "type": "shell",
      "label": "PlatformIO: Update Clangd Database (compiledb)",
      "command": "pio run -t compiledb",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "type": "shell",
      "label": "PlatformIO: Check (src/ only)",
      "command": "pio check --skip-packages",
      "problemMatcher": {
        "owner": "cppcheck",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+\\[(?:low|medium|high):(\\w+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
